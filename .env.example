# TaskForge Configuration Example
# Copy this file to .env and modify as needed

# Database
DATABASE_URL=sqlite:///./taskforge.db

# Application
APP_NAME=TaskForge
APP_VERSION=0.1.0
DEBUG=true

# User settings
DEFAULT_TIMEZONE=UTC
DEFAULT_DATE_FORMAT=%Y-%m-%d
DEFAULT_TIME_FORMAT=%H:%M:%S

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=taskforge.log